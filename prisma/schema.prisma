generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int @id @default(autoincrement())
  name        String
  description String
  links       ProfileLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model ProfileLink {
  id        Int @id @default(autoincrement())
  label     String
  url       String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id            Int @id @default(autoincrement())
  company       String
  position      String
  periodStart   String
  periodEnd     String?
  achievements  String[]
  profileId     Int
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id        Int @id @default(autoincrement())
  name      String
  url       String
  note      String?
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}